<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree view -->
        <record id="pie_cam_reconciliation_tree" model="ir.ui.view">
            <field name="name">pie.cam.reconciliation.tree</field>
            <field name="model">pie.cam.reconciliation</field>
            <field name="arch" type="xml">
                <tree string="CAM Reconciliations" decoration-success="state=='reconciled'" decoration-danger="state=='disputed'" decoration-muted="state=='closed'">
                    <field name="name"/>
                    <field name="property_id"/>
                    <field name="period"/>
                    <field name="total_cam_expenses" widget="monetary"/>
                    <field name="tenant_share_pct" widget="percentage"/>
                    <field name="tenant_amount" widget="monetary"/>
                    <field name="variance" widget="monetary"/>
                    <field name="state" widget="badge"/>
                </tree>
            </field>
        </record>

        <!-- Form view -->
        <record id="pie_cam_reconciliation_form" model="ir.ui.view">
            <field name="name">pie.cam.reconciliation.form</field>
            <field name="model">pie.cam.reconciliation</field>
            <field name="arch" type="xml">
                <form string="CAM Reconciliation">
                    <header>
                        <button name="action_reconcile" type="object" string="Reconcile" class="btn-primary" invisible="state not in ('draft','disputed')"/>
                        <button name="action_dispute" type="object" string="Mark Disputed" class="btn-warning" invisible="state not in ('draft','reconciled')"/>
                        <button name="action_close" type="object" string="Close" class="btn-secondary" invisible="state not in ('reconciled','disputed')"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,reconciled,disputed,closed"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="property_id"/>
                                <field name="period"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="total_cam_expenses" widget="monetary"/>
                                <field name="tenant_share_pct" widget="percentage"/>
                                <field name="tenant_amount" widget="monetary"/>
                                <field name="variance" widget="monetary"/>
                                <field name="reconciled"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="pie_cam_reconciliation_action" model="ir.actions.act_window">
            <field name="name">CAM Reconciliations</field>
            <field name="res_model">pie.cam.reconciliation</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new CAM / NNN reconciliation
                </p>
            </field>
        </record>
    </data>
</odoo>
