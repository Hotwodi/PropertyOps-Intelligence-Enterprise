<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree view -->
        <record id="pie_owner_report_tree" model="ir.ui.view">
            <field name="name">pie.owner.report.tree</field>
            <field name="model">pie.owner.report</field>
            <field name="arch" type="xml">
                <list string="Owner Reports">
                    <field name="name"/>
                    <field name="property_id"/>
                    <field name="owner_id"/>
                    <field name="period"/>
                    <field name="occupancy_rate" widget="percentage"/>
                    <field name="rent_collected" widget="monetary"/>
                    <field name="noi" widget="monetary"/>
                    <field name="ai_performance_score"/>
                    <field name="generated_date"/>
                    <field name="sent_date"/>
                </list>
            </field>
        </record>

        <!-- Form view -->
        <record id="pie_owner_report_form" model="ir.ui.view">
            <field name="name">pie.owner.report.form</field>
            <field name="model">pie.owner.report</field>
            <field name="arch" type="xml">
                <form string="Owner Report">
                    <header>
                        <button name="action_mark_sent" type="object" string="Mark Sent" class="btn-primary" invisible="sent_date != False"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="property_id"/>
                                <field name="owner_id"/>
                                <field name="period"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="occupancy_rate" widget="percentage"/>
                                <field name="ai_performance_score"/>
                                <field name="generated_date"/>
                                <field name="sent_date"/>
                            </group>
                        </group>
                        <group string="Financials">
                            <group>
                                <field name="rent_collected" widget="monetary"/>
                                <field name="delinquencies" widget="monetary"/>
                                <field name="maintenance_spend" widget="monetary"/>
                            </group>
                            <group>
                                <field name="noi" widget="monetary"/>
                                <field name="capex" widget="monetary"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="pie_owner_report_action" model="ir.actions.act_window">
            <field name="name">Owner Reports</field>
            <field name="res_model">pie.owner.report</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new owner report
                </p>
            </field>
        </record>
    </data>
</odoo>
