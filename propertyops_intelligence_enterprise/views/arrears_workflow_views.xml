<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree view -->
        <record id="pie_arrears_workflow_tree" model="ir.ui.view">
            <field name="name">pie.arrears.workflow.tree</field>
            <field name="model">pie.arrears.workflow</field>
            <field name="arch" type="xml">
                <tree string="Arrears Workflows" decoration-success="state=='resolved'" decoration-danger="state=='escalated'">
                    <field name="name"/>
                    <field name="tenant_id"/>
                    <field name="lease_id"/>
                    <field name="amount_overdue" widget="monetary"/>
                    <field name="days_overdue"/>
                    <field name="stage"/>
                    <field name="ai_collection_probability" widget="percentage"/>
                    <field name="last_action_date"/>
                    <field name="state" widget="badge"/>
                </tree>
            </field>
        </record>

        <!-- Form view -->
        <record id="pie_arrears_workflow_form" model="ir.ui.view">
            <field name="name">pie.arrears.workflow.form</field>
            <field name="model">pie.arrears.workflow</field>
            <field name="arch" type="xml">
                <form string="Arrears Workflow">
                    <header>
                        <button name="action_advance_stage" type="object" string="Advance Stage" class="btn-primary" invisible="state == 'resolved'"/>
                        <button name="action_escalate" type="object" string="Escalate" class="btn-danger" invisible="state in ('resolved','escalated')"/>
                        <field name="state" widget="statusbar" statusbar_visible="active,escalated,resolved"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="tenant_id"/>
                                <field name="lease_id"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="amount_overdue" widget="monetary"/>
                                <field name="days_overdue"/>
                                <field name="stage"/>
                                <field name="payment_plan_amount" widget="monetary"/>
                            </group>
                        </group>
                        <group string="AI &amp; Tracking">
                            <group>
                                <field name="ai_collection_probability" widget="percentage"/>
                            </group>
                            <group>
                                <field name="last_action_date"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="pie_arrears_workflow_action" model="ir.actions.act_window">
            <field name="name">Arrears Workflows</field>
            <field name="res_model">pie.arrears.workflow</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new arrears / collections workflow
                </p>
            </field>
        </record>
    </data>
</odoo>
